//
// named.conf
//
// Provided by Red Hat bind package to configure the ISC BIND named(8) DNS
// server as a caching only nameserver (as a localhost DNS resolver only).
//
// See /usr/share/doc/bind*/sample/ for example named configuration files.
//

options {
	directory		"/var/named";
	dump-file		"/var/named/data/cache_dump.db";
	statistics-file 	"/var/named/data/named_stats.txt";
	memstatistics-file	"/var/named/data/named_mem_stats.txt";
	secroots-file		"/var/named/data/named.secroots";
	recursing-file		"/var/named/data/named.recursing";
	allow-query		{ any; };
	allow-recursion		{ 192.168.68.0/22; 192.168.69.0/24; 192.168.70.0/24; localhost; };

	/* 
	 - If you are building an AUTHORITATIVE DNS server, do NOT enable recursion.
	 - If you are building a RECURSIVE (caching) DNS server, you need to enable 
   recursion. 
	 - If your recursive DNS server has a public IP address, you MUST enable access 
   control to limit queries to its legitimate users. Failing to do so will 
   cause your server to become part of large scale DNS amplification 
   attacks. Implementing BCP38 within your network would greatly 
   reduce such attack surface 
	*/
	recursion yes;
	forwarders { 192.168.68.1; 1.1.1.1; 8.8.8.8; };

	dnssec-validation yes;

	managed-keys-directory "/var/named/dynamic";
	geoip-directory "/usr/share/GeoIP";

	pid-file "/run/named/named.pid";
	session-keyfile "/run/named/session.key";

	/* https://fedoraproject.org/wiki/Changes/CryptoPolicy */
	include "/etc/crypto-policies/back-ends/bind.config";
};

{% if xcat_ddns_enabled | default(false) %}
// xCAT DDNS: the management node pushes A/PTR records with nsupdate.
// The same secret lives in /etc/xcat/nsupdate.key on the xCAT MN.
key "{{ xcat_ddns_tsig_key_name }}" {
	algorithm {{ xcat_ddns_tsig_algorithm }};
	secret "{{ xcat_ddns_tsig_secret }}";
};
{% endif %}

logging {
        channel default_debug {
                file "data/named.run";
                severity dynamic;
        };
};

zone "." IN {
	type hint;
	file "named.ca";
};

zone "edsonmanners.com" IN {
	type master;
	file "edsonmanners.com";
{% if xcat_ddns_enabled | default(false) %}
	allow-update { key {{ xcat_ddns_tsig_key_name }}; };
{% else %}
	allow-update { none; };
{% endif %}
	allow-transfer { {{ dns_slave_transfers }} };
	notify yes;
};

zone "tailscale" IN {
	type master;
	file "tailscale";
	allow-update { none; };
	allow-transfer { {{ dns_slave_transfers }} };
	notify yes;
};

zone "68.168.192.in-addr.arpa" IN {
	type master;
	file "68.168.192.in-addr.arpa";
{% if xcat_ddns_enabled | default(false) %}
	allow-update { key {{ xcat_ddns_tsig_key_name }}; };
{% else %}
	allow-update { none; };
{% endif %}
	allow-transfer { {{ dns_slave_transfers }} };
	notify yes;
};

zone "69.168.192.in-addr.arpa" IN {
	type master;
	file "69.168.192.in-addr.arpa";
	allow-update { none; };
	allow-transfer { {{ dns_slave_transfers }} };
	notify yes;
};

zone "70.168.192.in-addr.arpa" IN {
	type master;
	file "70.168.192.in-addr.arpa";
	allow-update { none; };
	allow-transfer { {{ dns_slave_transfers }} };
	notify yes;
};

zone "71.168.192.in-addr.arpa" IN {
	type master;
	file "71.168.192.in-addr.arpa";
	allow-update { none; };
	allow-transfer { {{ dns_slave_transfers }} };
	notify yes;
};

include "/etc/named.rfc1912.zones";
include "/etc/named.root.key";

