[Unit]
Description=Pan-Tilt ONVIF bridge for Frigate ({{ pantilt_backend }})
After=network.target mediamtx.service
Wants=mediamtx.service

[Service]
Type=simple
Restart=always
RestartSec=2
User=emanners
Group=emanners
SupplementaryGroups=i2c gpio
WorkingDirectory=/home/emanners
Environment=PANTILT_BACKEND={{ pantilt_backend }}
Environment=PANTILT_ONVIF_HOST={{ pantilt_onvif_host }}
Environment=PANTILT_ONVIF_PORT={{ pantilt_onvif_port }}
Environment=PANTILT_RTSP_PATH={{ pantilt_rtsp_path }}
Environment=PANTILT_HOME_PAN={{ pantilt_home_pan }}
Environment=PANTILT_HOME_TILT={{ pantilt_home_tilt }}
Environment=PANTILT_MAX_RATE={{ pantilt_max_rate }}
Environment=PANTILT_PAN_MIN={{ pantilt_pan_min }}
Environment=PANTILT_PAN_MAX={{ pantilt_pan_max }}
Environment=PANTILT_TILT_MIN={{ pantilt_tilt_min }}
Environment=PANTILT_TILT_MAX={{ pantilt_tilt_max }}
Environment=PANTILT_PAN_PIN={{ pantilt_pan_pin }}
Environment=PANTILT_TILT_PIN={{ pantilt_tilt_pin }}
Environment=PANTILT_I2C_BUS={{ pantilt_i2c_bus }}
Environment=PANTILT_I2C_ADDR={{ pantilt_i2c_addr }}
Environment=PANTILT_PAN_CH={{ pantilt_pan_ch }}
Environment=PANTILT_TILT_CH={{ pantilt_tilt_ch }}
Environment=GPIOZERO_PIN_FACTORY=lgpio
ExecStart=/usr/bin/python3 {{ pantilt_install_dir }}/pantilt_onvif.py

[Install]
WantedBy=multi-user.target
